# Скопируйте в .env и заполните. Файл .env НЕ коммитьте.
# Комментарии пишите на отдельных строках, не после значения.
# Пароли только из букв и цифр (они попадают в URL), например:
#   python -c "import secrets; print(secrets.token_hex(24))"

# --- Postgres ---
# POSTGRES_PASSWORD и пароль внутри DATABASE_URL должны совпадать
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@db:5432/job_tracker

# --- RabbitMQ / Celery ---
RABBITMQ_USER=jobtracker
RABBITMQ_PASSWORD=CHANGE_ME
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
CELERY_ENABLED=true

# --- Redis ---
REDIS_URL=redis://redis:6379/0
REDIS_STATISTICS_URL=redis://redis:6379/2

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- Безопасность приложения ---
# Минимум 32 символа, случайный: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME
# На сервере после создания демо-аккаунта поставьте false
ALLOW_REGISTRATION=true
# Пусто = CORS выключен
CORS_ORIGINS=

# --- Grafana ---
GRAFANA_PASSWORD=CHANGE_ME

# --- Только на сервере (Caddy) ---
DOMAIN=localhost
