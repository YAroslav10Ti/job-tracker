# Домен берётся из переменной DOMAIN в .env
{$DOMAIN} {
	encode gzip zstd

	# Метрики Prometheus ходят внутри docker-сети (api:8000), снаружи они не нужны
	@internal path /metrics /metrics/*
	respond @internal 404

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}

	reverse_proxy api:8000
}
